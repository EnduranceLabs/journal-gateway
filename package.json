{
  "name": "@journal-labs/bastion",
  "version": "0.5.3",
  "description": "Outbound bastion for connecting MCP servers and skills to Journal",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "journal",
    "journal-bastion",
    "mcp",
    "model-context-protocol",
    "bastion"
  ],
  "homepage": "https://github.com/EnduranceLabs/journal-bastion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnduranceLabs/journal-bastion.git"
  },
  "bugs": {
    "url": "https://github.com/EnduranceLabs/journal-bastion/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "bin": {
    "journal-bastion": "./dist/cli/main.js",
    "journal-temporal-mcp": "./dist/integrations/temporal/main.js"
  },
  "main": "./dist/cli/main.js",
  "types": "./dist/cli/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js"
    },
    "./hub": {
      "types": "./dist/hub/server.d.ts",
      "import": "./dist/hub/server.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "pnpm build && pnpm --filter ./testing/integration/ts test",
    "test:python": "cd clients/python && PYTHON_BIN=${PYTHON:-python3} && \"$PYTHON_BIN\" -c \"import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 'Python 3.11+ required; set PYTHON=/path/to/python3.11')\" && \"$PYTHON_BIN\" -m venv .venv && . .venv/bin/activate && python -m pip install -q --upgrade pip && python -m pip install -q -e \".[dev]\" && pytest tests/",
    "test:all": "pnpm test && pnpm test:integration",
    "check:lockfiles": "scripts/check-lockfiles.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.4.2",
    "ws": "^8.21.1",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/ws": "^8",
    "typescript": "^7.0",
    "vitest": "^3.2.7"
  }
}
